<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.saascommunication</package>
	<author>EnesT</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.saascommunication.SaasCommunicationModuleActivator</activator>
	
	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->
	
	<require_version>2.7.0</require_version>
	
	<!-- Extensions -->
	<extension>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
		<aware_of_module>org.openmrs.module.appointments</aware_of_module>
	</aware_of_modules>
	
	
	<advice>
		<point>org.openmrs.module.appointments.service.AppointmentsService</point>
		<class>org.openmrs.module.saascommunication.advice.AppointmentPublishAdvice</class>
	</advice>
	
	
	<!-- Required Privileges 
	<privilege>
		<name>Form Entry</name>
		<description>Allows user to access Form Entry pages/functions</description>
	</privilege>
	 /Required Privileges -->


	<!-- Required Global Properties -->
	<globalProperty>
		<property>saascommunication.organizationId</property>
		<defaultValue>default-organization</defaultValue>
		<description>
			Unieke ID van deze OpenMRS organisatie voor de SaaS communicatiemodule.
			Wordt meegestuurd in elk FHIR bericht zodat de communicatiemodule weet
			van welk ziekenhuis het bericht afkomstig is.
			Voorbeeld: amsterdam-amc, rotterdam-erasmus
		</description>
	</globalProperty>
	<!-- /Required Global Properties -->
	
